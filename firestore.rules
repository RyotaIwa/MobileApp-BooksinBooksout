rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isBookActivityCollection(collection) {
      return collection == 'purchases'
        || collection == 'rentals'
        || collection == 'reading_history';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /{collection}/{documentId} {
      allow read, delete: if isBookActivityCollection(collection)
        && isOwner(resource.data.userId);
      allow create: if isBookActivityCollection(collection)
        && isOwner(request.resource.data.userId);
      allow update: if isBookActivityCollection(collection)
        && isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }
  }
}
